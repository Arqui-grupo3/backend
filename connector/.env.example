# Connector contra el broker del curso (solo producción, en la EC2).
# Para desarrollo local usa local.env.example: con estas credenciales el connector
# consumiría las colas reales de REE y le quitaría los mensajes al nodo de producción.
RABBIT_URL=amqps://city.REE:TU_PASSWORD@broker.iic2173.org:5671/energy
RABBIT_QUEUE=city.REE.q
RABBIT_MARKET_QUEUE=market.REE
